rules_version = '2';

// Phase 0 baseline. Tighten per-feature in Phases 11 (cloud save), 12 (leaderboards/social),
// 13 (events). All player documents are keyed by uid; only the owner may read/write their own.
service cloud.firestore {
  match /databases/{database}/documents {

    // Player save mirror (Phase 11).
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public profile (Phase 12). Anyone authed can read to look up
    // friend codes / display names; only the owner can write.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend code reverse index (Phase 12). Cloud Functions only —
    // ensuring atomic claim-or-reject for uniqueness.
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Friend graph (Phase 12). Cloud Functions own creation so doc IDs
    // stay canonical and statuses can't be forged. Participants can
    // update (accept) or delete (decline / unfriend) directly.
    match /friendships/{docId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.aUid || request.auth.uid == resource.data.bUid);
      allow create: if false;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.aUid || request.auth.uid == resource.data.bUid)
        // Only the recipient may flip status to accepted.
        && (
          request.resource.data.status == resource.data.status
          || (request.resource.data.status == 'accepted'
              && request.auth.uid != resource.data.requestedByUid)
        );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.aUid || request.auth.uid == resource.data.bUid);
    }

    // Leaderboards (Phase 12) — writes go through Cloud Functions only; clients read.
    match /leaderboards/{board}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Live-events defined by Remote Config / admin tooling (Phase 13).
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
