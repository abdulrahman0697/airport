{
  "name": "skyhaven",
  "private": true,
  "version": "0.1.0",
  "description": "SkyHaven Tycoon — Capacitor monorepo root",
  "workspaces": ["app"],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test": "npm run test -w app",
    "typecheck": "npm run typecheck -w app",
    "cap:sync": "npm run build -w app && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "npm run build -w app && cap sync android && cd android && ./gradlew bundleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
